    },
    {
      "time_start": 7.0,
      "time_end": 8.0,
      "target_id": "camera",
      "type": "transform",
      "easing": "easeInOutQuad",
      "from": {
        "zoom": 1.0,
        "rotation": 0.0
      },
      "to": {
        "zoom": 1.5,
        "rotation": 15.0
      }
    },
    {
      "time_start": 8.0,
      "time_end": 9.0,
      "target_id": "camera",
      "type": "transform",
      "easing": "easeInOutQuad",
      "from": {
        "zoom": 1.5,
        "rotation": 15.0
      },
      "to": {
        "zoom": 1.0,
        "rotation": 0.0
      }
    }
