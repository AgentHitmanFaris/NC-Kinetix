    {
      "time_start": 6.0,
      "time_end": 6.5,
      "target_id": "text_scale",
      "type": "transform",
      "easing": "easeInOutQuad",
      "from": {
        "scale": 3.0
      },
      "to": {
        "scale": 0.0
      }
