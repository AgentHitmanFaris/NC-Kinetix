    {
      "time_start": 5.5,
      "time_end": 6.0,
      "target_id": "text_scale",
      "type": "transform",
      "easing": "easeInOutQuad",
      "from": {
        "scale": 1.0
      },
      "to": {
        "scale": 3.0
      }
