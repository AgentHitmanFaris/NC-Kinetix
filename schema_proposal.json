{
  "meta": {
    "version": "1.0",
    "project_name": "Kinetic Demo 1",
    "audio_file": "track.mp3",
    "bpm": 120
  },
  "assets": {
    "fonts": [
      { "id": "font_bold", "path": "assets/Roboto-Bold.ttf" },
      { "id": "font_reg", "path": "assets/Roboto-Regular.ttf" }
    ]
  },
  "layout": [
    {
      "id": "node_intro",
      "type": "group",
      "position": { "x": 0, "y": 0 },
      "children": [
        {
          "id": "word_hello",
          "type": "text",
          "content": "HELLO",
          "font_id": "font_bold",
          "position": { "x": -100, "y": 0 }
        },
        {
          "id": "word_world",
          "type": "text",
          "content": "WORLD",
          "font_id": "font_reg",
          "position": { "x": 100, "y": 0 }
        }
      ]
    }
  ],
  "timeline": [
    {
      "time_start": 0.0,
      "time_end": 2.0,
      "target_id": "camera",
      "type": "transform",
      "easing": "easeOutElastic",
      "from": { "x": 0, "y": 1000, "zoom": 0.5 },
      "to": { "x": 0, "y": 0, "zoom": 1.0 }
    },
    {
      "time_start": 2.0,
      "time_end": 3.0,
      "target_id": "word_hello",
      "type": "color",
      "easing": "linear",
      "from": { "r": 1, "g": 1, "b": 1, "a": 1 },
      "to": { "r": 1, "g": 0, "b": 0, "a": 1 }
    }
  ]
}
